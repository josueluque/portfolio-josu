---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import type { Lang } from "@/i18n/types";
import { profile } from "@/data/profile";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  canonical?: string;
}

const {
  description,
  title,
  lang,
  image = "/porfolio.webp",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://josueluque.vercel.app";
const ogImage = new URL(image, siteUrl).toString();
const ogLocale = lang === "es" ? "es_AR" : "en_US";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: siteUrl,
  sameAs: [profile.linkedin, profile.github],
  jobTitle: profile.role[lang],
  email: `mailto:${profile.email}`,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical + alternates -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL("/", siteUrl).toString()} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={`${profile.name} · Portfolio`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="darkreader-lock" />
    <ViewTransitions />
  </head>

  <body class="relative text-black dark:text-white">
    <div
      class="fixed inset-0 z-[-2] bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(79,184,180,0.16),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(79,184,180,0.12),rgba(0,0,0,0))]"
    >
    </div>
    <!-- Grain texture overlay for tactile depth -->
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035] dark:opacity-[0.05]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
    <style is:global>
      :root {
        color-scheme: light;
      }

      :root.dark {
        color-scheme: dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        background-color: #f9fafb; /* gray-50 */
      }

      html.dark {
        background-color: #030712; /* gray-950 */
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @media (prefers-color-scheme: dark) {
        @keyframes blur {
          from {
            border: 0px;
          }
          to {
            box-shadow:
              0px 5px 50px -5px rgba(0, 0, 0, 0.1),
              0px 0px 0 1px rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            border-width: 1px;
            border-color: rgba(0, 0, 0);
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 9999px;
          }
        }
      }

      /* ── Design system: staggered entrance animations ─────────────── */
      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 120ms; }
      .anim-delay-2 { animation-delay: 260ms; }
      .anim-delay-3 { animation-delay: 400ms; }
      .anim-delay-4 { animation-delay: 540ms; }

      /* Solid accent color for the hero name and header logo */
      .gradient-name {
        color: #3C9D9A;
      }
      :global(.dark) .gradient-name {
        color: #85D0CC;
      }

      /* Scroll-triggered reveal for named sections (below the fold) */
      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
