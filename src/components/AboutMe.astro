---
import type { Lang } from "@/i18n/types"
import { profile } from "@/data/profile"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<article class="max-w-3xl mx-auto flex flex-col items-center gap-8 text-lg text-gray-700 dark:text-gray-300 text-pretty md:flex-row md:items-start">
  {
    profile.photo && (
      <img
        src={profile.photo}
        alt={profile.name}
        width="160"
        height="160"
        loading="lazy"
        class="size-47 rounded-2xl object-cover object-center border border-gray-300 dark:border-gray-700 shadow-md shrink-0 rotate-2 transition-transform duration-300 ease-out hover:rotate-0 motion-reduce:transform-none motion-reduce:transition-none"
      />
    )
  }
  <div class="flex flex-col gap-4 items-start">
    {profile.aboutText[lang].map((parrafo) => <p>{parrafo}</p>)}
  </div>
</article>
