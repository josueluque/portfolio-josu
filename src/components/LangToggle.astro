---
import type { Lang } from "@/i18n/types"
import { getT, homeFor, otherLang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = getT(lang)
const target = otherLang(lang)
const label = target.toUpperCase() // muestra el idioma al que se cambia
---

<a
  href={homeFor(target)}
  class="flex items-center gap-x-1.5 text-xs font-semibold rounded-full px-2 py-1 transition hover:scale-110 hover:text-yellow-500 dark:hover:text-yellow-400"
  aria-label={t("lang.toggle_aria")}
  title={t("lang.toggle_aria")}
>
  {label}
</a>
