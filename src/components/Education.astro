---
import type { Lang } from "@/i18n/types"
import { getT } from "@/i18n/ui"
import { education, languages } from "@/data/education"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = getT(lang)

const card =
  "rounded-xl border border-gray-300/60 dark:border-white/10 bg-white/40 dark:bg-gray-900/40 p-5"
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    education.map((entry) => (
      <div class={card}>
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white">
          {entry.title[lang]}
        </h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{entry.org[lang]}</p>
      </div>
    ))
  }

  <div class={card}>
    <h3 class="text-lg font-semibold text-gray-800 dark:text-white">
      {t("education.language")}
    </h3>
    <ul class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      {languages.map((l) => (
        <li>
          {l.name[lang]} · {l.level[lang]}
        </li>
      ))}
    </ul>
  </div>
</div>
