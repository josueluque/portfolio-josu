---
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
import type { Lang } from "@/i18n/types"
import { getT } from "@/i18n/ui"
import { profile } from "@/data/profile"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = getT(lang)
---

<div class="max-w-2xl">
  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {lang === "es" ? "Hola, soy " : "Hi, I'm "}
    <span class="gradient-name">{profile.name}</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-3 text-2xl font-semibold text-accent-700 dark:text-accent-300 min-h-[2.25rem]"
    aria-label={profile.heroRoles[lang].join(", ")}
  >
    <span
      id="hero-typewriter"
      data-roles={JSON.stringify(profile.heroRoles[lang])}
      aria-hidden="true"></span><span class="tw-cursor" aria-hidden="true">|</span>
  </p>

  <p
    class="anim-fade-in anim-delay-3 mt-6 text-xl text-gray-800 dark:text-gray-300 text-pretty"
  >
    {profile.heroTagline[lang]}
  </p>

  <nav
    class="anim-fade-in anim-delay-4 flex flex-wrap gap-4 mt-8 items-center"
    aria-label="Redes sociales y contacto"
  >
    <SocialPill
      id="contact-pill"
      href={`mailto:${profile.email}`}
      target="_self"
      rel=""
      data-email={profile.email}
      data-label={t("social.contact")}
      data-copied={t("social.copied")}
      aria-label={t("social.contact_aria")}
    >
      <MailIcon class="size-4" />
      <span id="contact-label">{t("social.contact")}</span>
    </SocialPill>
    <SocialPill href={profile.linkedin}>
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href={profile.github}>
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>

<style>
  .tw-cursor {
    animation: tw-blink 1s step-end infinite;
    color: inherit;
    font-weight: 400;
  }
  @keyframes tw-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw-cursor {
      animation: none;
    }
  }
</style>

<script>
  function initTypewriter() {
    const el = document.getElementById("hero-typewriter")
    if (!el) return
    const roles = JSON.parse(el.dataset.roles || "[]")
    if (!roles.length) return

    // Respetar reduce-motion: mostrar la primera frase fija, sin animar.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    if (reduce) {
      el.textContent = roles[0]
      return
    }

    let roleIdx = 0,
      charIdx = 0,
      deleting = false
    const TYPE = 90,
      ERASE = 45,
      HOLD = 1400,
      GAP = 350

    function tick() {
      const word = roles[roleIdx]
      el!.textContent = word.slice(0, charIdx)
      if (!deleting) {
        if (charIdx < word.length) {
          charIdx++
          setTimeout(tick, TYPE)
        } else {
          deleting = true
          setTimeout(tick, HOLD)
        }
      } else {
        if (charIdx > 0) {
          charIdx--
          setTimeout(tick, ERASE)
        } else {
          deleting = false
          roleIdx = (roleIdx + 1) % roles.length
          setTimeout(tick, GAP)
        }
      }
    }
    tick()
  }
  document.addEventListener("astro:page-load", initTypewriter)

  function copyEmail(email: string): Promise<void> {
    if (navigator.clipboard?.writeText) {
      return navigator.clipboard.writeText(email)
    }
    // Fallback para navegadores sin Clipboard API o contexto no seguro.
    return new Promise((resolve, reject) => {
      const area = document.createElement("textarea")
      area.value = email
      area.setAttribute("readonly", "")
      area.style.position = "fixed"
      area.style.opacity = "0"
      document.body.appendChild(area)
      area.select()
      try {
        document.execCommand("copy")
        resolve()
      } catch (err) {
        reject(err)
      } finally {
        document.body.removeChild(area)
      }
    })
  }

  function initContactPill() {
    const pill = document.getElementById("contact-pill")
    const label = document.getElementById("contact-label")
    if (!pill || !label) return

    const email = pill.dataset.email || ""
    const defaultText = pill.dataset.label || label.textContent || ""
    const copiedText = pill.dataset.copied || "Copied!"
    let resetTimer: number | undefined

    // No preventDefault: el mailto sigue funcionando (misma pestaña, sin blank).
    pill.addEventListener("click", () => {
      if (!email) return
      copyEmail(email)
        .then(() => {
          label.textContent = copiedText
          window.clearTimeout(resetTimer)
          resetTimer = window.setTimeout(() => {
            label.textContent = defaultText
          }, 1600)
        })
        .catch(() => {
          /* Si falla la copia, el mailto ya se disparó como respaldo. */
        })
    })
  }
  document.addEventListener("astro:page-load", initContactPill)
</script>
