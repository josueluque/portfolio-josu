---
import Briefcase from "@/components/icons/Briefcase.astro"

interface Props {
  title: string
  company: string
  description: string
  date: string
  current?: boolean
}

const { title, company, description, date, current = false } = Astro.props
---

<div
  class="relative mx-10 pb-10 before:absolute before:left-[-27px] before:top-2 before:block before:h-full before:border-l-2 before:border-black/15 dark:before:border-white/10 before:content-['']"
>
  <span
    class="absolute -left-[46px] -top-1 flex size-9 items-center justify-center rounded-full border border-gray-300/70 bg-white/70 text-accent-400 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-900/70"
    aria-hidden="true"
  >
    {current && (
      <span class="animate-ping motion-reduce:animate-none absolute inline-flex size-full rounded-full bg-accent-400/50"></span>
    )}
    <Briefcase class="relative size-5" />
  </span>

  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
    <h3 class="text-xl font-bold text-accent-400">{title}</h3>
    <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">-</span>
    <span class="text-sm font-semibold gradient-name">{company}</span>
  </div>

  <time class="block text-sm text-accent-700/80 dark:text-accent-400/80">{date}</time>

  <p class="mt-2 text-gray-600 dark:text-gray-300">{description}</p>
</div>
