---
import type { Lang } from "@/i18n/types"
import { skillGroups, softSkills } from "@/data/skills"

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const chip =
  "flex gap-x-2 rounded-full text-sm py-1.5 px-3 bg-gray-200/70 text-gray-800 dark:bg-gray-800 dark:text-gray-200 border border-gray-300/60 dark:border-white/10"
---

<div class="flex flex-col gap-y-8">
  {
    skillGroups.map((group) => (
      <div>
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3">
          {group.title[lang]}
        </h3>
        <ul class="flex flex-row flex-wrap gap-2">
          {group.items.map((item) => (
            <li>
              <span class={chip}>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <div>
    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3">
      {softSkills.title[lang]}
    </h3>
    <ul class="flex flex-row flex-wrap gap-2">
      {softSkills.items.map((item) => (
        <li>
          <span class={chip}>{item[lang]}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
